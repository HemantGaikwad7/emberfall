# Free Groq key: https://console.groq.com/keys
# Leave GROQ_API_KEY empty to run the deterministic offline rules engine.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Tried in order when the main model hits its free daily limit:
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FalkorDB Cloud (free tier):
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=true
# or a single URL instead of host/port/user/pass:
# FALKORDB_URL=falkor://default:password@host:port
